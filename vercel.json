{
  "buildCommand": "npm run build",
  "outputDirectory": "Frontend/dist",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 60
    },
    "api/auth/[...path].js": {
      "maxDuration": 60
    },
    "api/interview/[...path].js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/register",
      "destination": "/index.html"
    },
    {
      "source": "/interview",
      "destination": "/index.html"
    },
    {
      "source": "/interview/:interviewId",
      "destination": "/index.html"
    }
  ]
}
